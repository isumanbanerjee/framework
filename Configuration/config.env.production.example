# Production environment configuration example.
# Copy to config.env.production and adjust as needed. Debug output is off,
# logging is scoped to what's actionable, and CORS is locked to real origins.

DB_TYPE=mysql
DB_HOST=prod-db.internal
DB_NAME=omniophp
DB_USERNAME=omniophp
DB_PASSWORD=
DB_PORT=3306
USE_ENCRYPTION=true
ENCRYPTION_KEY=
DB_CONNECTION_TIMEOUT=5
DB_FAILOVER_HOST=
DB_FAILOVER_PORT=
DB_FAILOVER_USERNAME=
DB_FAILOVER_PASSWORD=

QUERY_BUILDER_ENABLED=true
SLOW_QUERY_THRESHOLD=2

# Cache / queue / storage.
CACHE_DRIVER=redis
CACHE_REDIS_HOST=prod-redis.internal
CACHE_REDIS_PORT=6379
CACHE_DEFAULT_TTL=3600
QUEUE_DRIVER=database
STORAGE_DRIVER=s3
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=

# Application
APP_NAME=OmnioPHP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

# Error handling — never leak stack traces to clients.
ERROR_ENVIRONMENT=production
ERROR_DEBUG_MODE=false
ERROR_RATE_LIMIT=100

# Logging — only what's actionable; warning and above.
LOG_CHANNEL=single
LOG_LEVEL=warning
LOG_PATH=storage/logs/production.log
LOG_MAX_SIZE=5242880
LOG_RETENTION_DAYS=30

# Rate limiting — enforced in production.
RATE_LIMIT=60
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GLOBAL=1000

# CORS — restrict to real production origin(s), never '*'.
CORS_ALLOWED_ORIGINS=https://example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_SUPPORTS_CREDENTIALS=true
