# Testing environment configuration example.
# Copy to config.env.testing and adjust as needed. Uses an in-memory SQLite
# database so the test suite needs no external services.

DB_TYPE=sqlite
DB_PATH=:memory:
DB_NAME=testing
DB_USERNAME=
DB_PASSWORD=

QUERY_BUILDER_ENABLED=true

# Cache / queue / storage use local drivers during tests.
CACHE_DRIVER=file
QUEUE_DRIVER=database
STORAGE_DRIVER=local

# Application
APP_NAME=OmnioPHP (testing)
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_PATH=storage/logs/testing.log
