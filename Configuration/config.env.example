DB_TYPE=mysql
DB_HOST=localhost
DB_NAME=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=
DB_PATH=/path/to/your/sqlite/database
DB_PORT=3306
DB_CHARSET=utf8
DB_SOCKET=
USE_ENCRYPTION=false
ENCRYPTION_KEY=
DB_CONNECTION_TIMEOUT=5
DB_FAILOVER_HOST=failover_host
DB_FAILOVER_PORT=failover_port
DB_FAILOVER_USERNAME=failover_username
DB_FAILOVER_PASSWORD=
CACHE_TTL=3600
QUERY_BUILDER_ENABLED=true
SLOW_QUERY_THRESHOLD=2
SHARDING_CONFIG=/path/to/your/sharding_config.json
METADATA_CACHE_TTL=3600
QUERY_RETRY_ATTEMPTS=3
QUERY_RETRY_DELAY=1000

# Session Configuration
SESSION_FLASH_KEY=flash_messages
SESSION_CSRF_TOKEN_KEY=csrf_token

# Auth Configuration
AUTH_TABLE=users
AUTH_PRIMARY_KEY=id
AUTH_IDENTITY_COLUMN=email
AUTH_PASSWORD_COLUMN=password
AUTH_REMEMBER_TOKEN_COLUMN=remember_token
AUTH_REMEMBER_DURATION=2592000

# Error Configuration
ERROR_ENVIRONMENT=production
ERROR_DEBUG_MODE=false
ERROR_RATE_LIMIT=100
ERROR_TEMPLATE_PATH=

# Severity Levels
SEVERITY_DEBUG=DEBUG
SEVERITY_INFO=INFO
SEVERITY_WARNING=WARNING
SEVERITY_ERROR=ERROR
SEVERITY_CRITICAL=CRITICAL
SEVERITY_FATAL=FATAL

# ==========================================
# ENTERPRISE MODULES CONFIGURATION
# ==========================================

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=app_cache_
CACHE_DEFAULT_TTL=3600
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DATABASE=0
CACHE_MEMCACHED_HOST=127.0.0.1
CACHE_MEMCACHED_PORT=11211
CACHE_FILE_PATH=storage/cache
CACHE_APCU_ENABLED=false

# Middleware Configuration
MIDDLEWARE_GLOBAL=log
MIDDLEWARE_WEB=csrf,log
MIDDLEWARE_API=throttle,json,cors,log
MIDDLEWARE_ADMIN=auth,admin,csrf,log

# Template Configuration
TEMPLATE_PATH=views
TEMPLATE_CACHE_PATH=storage/views
TEMPLATE_CACHE_ENABLED=true
TEMPLATE_DEBUG_MODE=false

# Queue Configuration
QUEUE_DRIVER=database
QUEUE_DEFAULT=default
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_FILE_PATH=storage/queues
QUEUE_FAILED_TABLE=failed_jobs

# Event Configuration
EVENT_QUEUE_ENABLED=true
EVENT_QUEUE_CONNECTION=default

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_URL=/storage
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_FTP_HOST=
STORAGE_FTP_PORT=21
STORAGE_FTP_USERNAME=
STORAGE_FTP_PASSWORD=
STORAGE_FTP_ROOT=/

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourapp.com
MAIL_FROM_NAME=Your Application
MAIL_AUTH=true

# HTTP Client Configuration
HTTP_TIMEOUT=30
HTTP_VERIFY_SSL=true
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=Enterprise-PHP-Framework/1.0

# Rate Limiting Configuration
RATE_LIMIT=60
RATE_LIMIT_DECAY=1
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GLOBAL=1000

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=false

# Localization Configuration
LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_PATH=resources/lang

# Application Configuration
APP_NAME=Enterprise PHP Framework
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Logging Configuration
LOG_CHANNEL=single
LOG_LEVEL=info
LOG_PATH=storage/logs/app.log
LOG_MAX_SIZE=5242880
LOG_RETENTION_DAYS=30

# Pagination Configuration
PAGINATION_PER_PAGE=15
PAGINATION_MAX_LINKS=7

# Console Configuration
CONSOLE_VERBOSITY=normal
CONSOLE_ANSI_ENABLED=true
