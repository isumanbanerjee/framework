# Local development environment configuration example.
# Copy to config.env.development (or plain config.env) and adjust as needed.
# Optimized for fast local iteration: verbose logging, no caching layers,
# and debug output enabled everywhere.

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=omniophp_dev
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306

QUERY_BUILDER_ENABLED=true
SLOW_QUERY_THRESHOLD=2

# Cache / queue / storage use local drivers during development.
CACHE_DRIVER=file
CACHE_DEFAULT_TTL=60
QUEUE_DRIVER=database
STORAGE_DRIVER=local

# Application
APP_NAME=OmnioPHP (development)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Error handling — surface full details locally.
ERROR_ENVIRONMENT=development
ERROR_DEBUG_MODE=true

# Logging — log everything while iterating.
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_PATH=storage/logs/development.log

# CORS — permissive for local frontend dev servers.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
