# Staging environment configuration example.
# Copy to config.env.staging and adjust as needed. Mirrors production
# infrastructure choices but keeps enough logging/debug signal to
# reproduce issues before they reach production.

DB_TYPE=mysql
DB_HOST=staging-db.internal
DB_NAME=omniophp_staging
DB_USERNAME=omniophp
DB_PASSWORD=
DB_PORT=3306
USE_ENCRYPTION=true
ENCRYPTION_KEY=

QUERY_BUILDER_ENABLED=true
SLOW_QUERY_THRESHOLD=2

# Cache / queue / storage use the same drivers as production.
CACHE_DRIVER=redis
CACHE_REDIS_HOST=staging-redis.internal
CACHE_REDIS_PORT=6379
CACHE_DEFAULT_TTL=3600
QUEUE_DRIVER=database
STORAGE_DRIVER=local

# Application
APP_NAME=OmnioPHP (staging)
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_TIMEZONE=UTC

# Error handling — no stack traces to clients, but still logged in full.
ERROR_ENVIRONMENT=staging
ERROR_DEBUG_MODE=false

# Logging — enough signal to reproduce staging-only bugs.
LOG_CHANNEL=single
LOG_LEVEL=info
LOG_PATH=storage/logs/staging.log

# CORS — restrict to the staging frontend origin(s).
CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
